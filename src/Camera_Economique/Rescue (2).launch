<?xml version="1.0"?> 
<launch>
<arg name="view" value="true" />

   <node pkg="cv_camera" type="cv_camera_node" name="cv_camera" output="screen">
        <param name="flip_image" value="false" />
        <param name="device_path" value="/dev/video0" />

    </node>
    
    <node pkg="cv_camera" type="cv_camera_node" name="cv_camera2" output="screen">
        <param name="flip_image" value="true" />
        <param name="device_id" value="2" />
<!--        <param name="image_width" value="4672" />
        <param name="image_height" value="3504" /> -->
        <param name="image_width" value="320" />
        <param name="image_height" value="240" />

        <param name="frame_rate" value="1"/>
    </node>
    
    <node pkg="cv_camera" type="cv_camera_node" name="cv_camera4" output="screen">
        <param name="flip_image" value="true" />
        <param name="device_id" value="4" />
        <param name="image_width" value="320" />
        <param name="image_height" value="240" /> 

        <param name="frame_rate" value="1"/>
    </node>
    
     <node pkg="cv_camera" type="cv_camera_node" name="cv_camera6" output="screen">
        <param name="flip_image" value="true" />
        <param name="device_id" value="6" />

        <param name="image_width" value="320" />
        <param name="image_height" value="240" /> 

        <param name="frame_rate" value="1"/>
    </node>

    <!--<node name="rosbag_record" pkg="rosbag" type="record" args="-O //home/ros/catkin_ws/src/ROBOCUP2024/src/videotest.bag /cv_camera/image_raw" output="screen"/>-->
    <!--<node pkg="cv_camera" type="cv_camera_node" name="cv_camera" output="screen">
        <param name="flip_image" value="false" />
        <param name="device_path" value="/dev/video0" />
        <param name="image_width" value="640" />
        <param name="image_height" value="480" />

    </node>-->
    
    <node pkg="ROBOCUP2024" type="ROBOCUP2024_node" name="titi" output="screen"></node>
    
    <group if="$(arg view)">

<!-- stuff that will only be evaluated if foo is true -->
        <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/output_image_topic"/>
        <param name="autosize" value="true" />
  </node>
  
  <node name="image_view2" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/output_image_topic2"/>
        <param name="autosize" value="true" />
  </node>
  
  <node name="image_view3" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/output_image_topic3"/>
        <param name="autosize" value="true" />
  </node>
  
  <node name="image_view4" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/output_image_topic4"/>
        <param name="autosize" value="true" />
  </node>
  
<!--  <node name="image_view6" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/cv_camera10/image_raw"/>
        <param name="autosize" value="true" />
  </node>
  
  <node name="image_view7" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/cv_camera12/image_raw"/>
        <param name="autosize" value="true" />
  </node>
  
  <node name="image_view8" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/cv_camera14/image_raw"/>
        <param name="autosize" value="true" />
  </node>   -->
  
  </group>
    <!--<node pkg="urg_node" type="urg_node" name="hokuyo_node" output="screen"><param name="device_path" value="/dev/ttyACM0"/></node>
    <node pkg="ROBOCUP2024" type="ROBOCUP2024_odometrie_node" name="titi" output="screen"></node>-->
    <!--<node pkg="ROBOCUP2024" type="ROBOCUP2024_Exploration_auto_node" name="titi" output="screen"></node>-->
    <!--<node pkg="ROBOCUP2024" type="ROBOCUP2024_recuperation_data_auto_node" name="titi" output="screen"></node>-->
    <!--<node pkg="ROBOCUP2024" type="ROBOCUP2024_copie_trajet_node" name="titi" output="screen"></node>-->

</launch>

