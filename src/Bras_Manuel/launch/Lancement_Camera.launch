<?xml version="1.0"?>
<launch>   

	<node pkg="bras_robotik" type="cv_camera_node" name="cv_camera" output="screen">
		<param name="flip_image" value="false"/>
		<param name="device_path" value="0"/>
		<param name="image_width" value="320"/>
		<param name="image_height" value="240" />
		<param name="frame_rate" value="15" />
	</node>
      
</launch>
