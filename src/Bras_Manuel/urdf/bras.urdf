<?xml version="1.0"?>
<robot name="bras">

  <material name="black">
    <color rgba="0.109 0.101 0.090 1"/>
  </material>

  <material name="orange">
    <color rgba="0.905 0.674 0.313 1"/>
  </material>

  <material name="blue">
    <color rgba="0.254 0.317 0.784 1"/>
  </material>

  <material name="green">
    <color rgba="0.219 0.878 0.239 1"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.4 0.4 0.4 1"/>
  </material>

  <material name="magenta">
    <color rgba="0.831 0.286 0.749 1"/>
  </material>

  <material name="light_gray">
    <color rgba="0.701 0.701 0.701 1"/>
  </material>

  <material name="yellow">
    <color rgba="1 1 0 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="double_shoulder">
    <visual>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/double_shoulder.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/double_shoulder.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="arm">
    <visual>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/arm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/arm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="upper_forearm">
    <visual>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/upper_forearm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/upper_forearm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="lower_forearm">
    <visual>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/lower_forearm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/lower_forearm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="wrist">
    <visual>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/wrist.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="magenta"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/wrist.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="gripper_body">
    <visual>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/gripper_body.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/gripper_body.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="gripper_finger1">
    <visual>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/gripper_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/gripper_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="gripper_finger2">
    <visual>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/gripper_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://urdf_bras/meshes/gripper_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_link_to_double_shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="double_shoulder"/> 
    <origin xyz="0 0 0.087" rpy="0 0 0" />
    <axis xyz="0.0 0.0 1.0"/>
    <!--<limit upper="6.283185" lower="0.0" effort="100" velocity="100"/>-->
    <limit upper="6" lower="0.0" effort="100" velocity="100"/>
  </joint>

  <joint name="double_shoulder_to_arm" type="revolute">
    <parent link="double_shoulder"/>
    <child link="arm"/>
    <origin xyz="0 0 0.056" rpy="0 0 0" />
    <axis xyz="1.0 0.0 0.0"/>
    <limit upper="1.570796" lower="-1.570796" effort="100" velocity="100"/>
  </joint>

  <joint name="arm_to_upper_forearm" type="revolute">
    <parent link="arm"/>
    <child link="upper_forearm"/>
    <origin xyz="0 -0.070 0.300" rpy="0 0 0" />
    <axis xyz="1.0 0.0 0.0"/>
    <limit upper="1.570796" lower="-1.570796" effort="100" velocity="100"/>
  </joint>

  <joint name="upper_forearm_to_lower_forearm" type="revolute">
    <parent link="upper_forearm"/>
    <child link="lower_forearm"/>
    <origin xyz="0 -0.1545 0.0" rpy="0 0 0" />
    <axis xyz="0.0 1.0 0.0"/>
    <limit upper="6" lower="0" effort="100" velocity="100"/>
  </joint>

  <joint name="lower_forearm_to_wrist" type="revolute">
    <parent link="lower_forearm"/>
    <child link="wrist"/>
    <origin xyz="0 -0.0955 0.0" rpy="0 0 0" />
    <axis xyz="1.0 0.0 0.0"/>
    <limit upper="1.570796" lower="-1.570796" effort="100" velocity="100"/>
  </joint>

  <joint name="wrist_to_gripper_body" type="revolute">
    <parent link="wrist"/>
    <child link="gripper_body"/>
    <origin xyz="0 -0.075 0.0" rpy="0 0 0" />
    <axis xyz="0.0 1.0 0.0"/>
    <limit upper="3.141592" lower="-3.141592" effort="100" velocity="100"/>
  </joint>

  <joint name="gripper_body_to_gripper_finger1" type="prismatic">
    <parent link="gripper_body"/>
    <child link="gripper_finger1"/>
    <origin xyz="0 -0.072 0.0" rpy="0 0 0" />
    <axis xyz="1.0 0.0 0.0"/>
    <limit upper="-0.02" lower="-0.055" effort="100" velocity="100"/>
  </joint>

  <joint name="gripper_body_to_gripper_finger2" type="prismatic">
    <parent link="gripper_body"/>
    <child link="gripper_finger2"/>
    <origin xyz="0 -0.072 0.0" rpy="0 3.141592 0" />
    <axis xyz="1.0 0.0 0.0"/>
    <limit upper="-0.02" lower="-0.055" effort="100" velocity="100"/>
  </joint>


</robot>
