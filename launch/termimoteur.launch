<launch>
    <!-- Turtlesim Node -->
    <node respawn="true" pkg="joy" type="joy_node" name="joystick">
        <param name="dev" type="string" value="/dev/input/js2"/>
        <param name="deadzone" value="0.12"/>
    </node>

    <!-- robocup2024_republish_joy_node -->
    <node pkg="robocup2024" type="robocup2024_republish_joy_node" name="robocup2024_republish_joy" output="screen">
        <!-- Ajoutez ici des paramètres supplémentaires si nécessaire -->
    </node>
</launch>
