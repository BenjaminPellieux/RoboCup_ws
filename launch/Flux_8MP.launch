<?xml version="1.0"?> 
<launch>
    <arg name="view" value="true" />
    <node pkg="ROBOCUP2024" type="ROBOCUP2024_camera_publisher" name="titi" output="screen"></node>
    
    <group if="$(arg view)">
<!-- stuff that will only be evaluated if foo is true -->
        <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
        <remap from="image" to="/cv_camera/image_raw"/>
        <param name="autosize" value="true" />
        <!-- <param name="width" value="800"/>
        <param name="height" value="600"/> -->
  	</node>
     </group>
     
     <!-- <node name="rosbag_record" pkg="rosbag" type="record" args="-_-buffsize=4096 -O /media/sf_Echange_Disque_Externe/videotest.bag /cv_camera/image_raw" output="screen"/> -->

     <node pkg="ROBOCUP2024" type="ROBOCUP2024_node" name="tatat" output="screen"></node>

</launch>

